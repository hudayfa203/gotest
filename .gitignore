# CI regenerates them on every build, so they are not committed.
/android/
/ios/

# secrets: signing keys and Firebase / Apple credentials never go into git
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
.env
.env.*
!.env.example
