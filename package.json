{
  "name": "goworld-news-mobile",
  "version": "1.2.1",
  "private": true,
  "description": "GO World News — Android and iOS app (Expo / React Native). Test APKs are built by GitHub Actions and published under Releases.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typegen": "node scripts/typegen.js",
    "typecheck": "node scripts/typegen.js && tsc --noEmit",
    "test": "jest",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "test:visual": "playwright test",
    "prebuild:native": "expo prebuild --clean --no-install",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "build:apk": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.105.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-persist-client": "^5.105.3",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
